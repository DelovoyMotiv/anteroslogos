# Force rebuild trigger
node_modules
.git
*.log

# Exclude test files from deployment
**/__tests__
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx

# Exclude development files
.kiro
docs
examples
grafana
cache
artifacts
jscpd-report.json

# Exclude non-essential API endpoints to stay under Vercel limit
api/__tests__
api/lib/**

# Exclude old endpoints replaced by unified endpoints
# Use api/keys.ts instead
api/api-keys.ts
api/agent-keys.ts

# Use api/status.ts instead
api/health.ts
api/ready.ts
api/metrics.ts

# Use api/auth.ts instead
api/challenge.ts
api/handshake.ts

# Exclude wrap-openapi (use wrap-with-billing instead)
api/v1/agent/wrap-openapi.ts
