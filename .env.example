# Contact Form Configuration (Choose one option)
# Option 1: Custom Backend
# VITE_CONTACT_FORM_ENDPOINT=https://api.yoursite.com/contact

# Option 2: Formspree (https://formspree.io - Free tier: 50 submissions/month)
# VITE_FORMSPREE_ID=your_formspree_id

# Option 3: Web3Forms (https://web3forms.com - Free, unlimited submissions)
# VITE_WEB3FORMS_KEY=your_web3forms_access_key

# Note: If no service is configured, submissions are stored in localStorage as backup

# Analytics (Optional)
# VITE_GA_TRACKING_ID=G-XXXXXXXXXX
# VITE_GTM_ID=GTM-XXXXXXX

# SEO & Meta
VITE_SITE_URL=https://anoteroslogos.com
VITE_SITE_NAME=Anóteros Lógos
VITE_SITE_DESCRIPTION=Generative Engine Optimization Agency

# Feature Flags (Optional)
# VITE_ENABLE_ANALYTICS=false
# VITE_MAINTENANCE_MODE=false

# ==================== SUPABASE BACKEND CONFIGURATION ====================
# Get these from: https://app.supabase.com/project/_/settings/api
# Required for cloud storage, authentication, and global insights

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# OAuth Redirect Configuration
# Production: https://anoteroslogos.com/auth/callback
# Development: http://localhost:5173/auth/callback
# Staging: https://staging.anoteroslogos.com/auth/callback
# IMPORTANT: Must match OAuth provider settings in Supabase Dashboard
VITE_AUTH_REDIRECT_URL=http://localhost:5173/auth/callback

# Site URL (used for OAuth redirects and email links)
# Production: https://anoteroslogos.com
# Development: http://localhost:5173
VITE_SITE_URL=http://localhost:5173

# Server-side Supabase credentials (for API routes)
# Same as above, but without VITE_ prefix for server-side usage
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ==================== USDC SUBSCRIPTION BILLING CONFIGURATION ====================
# CRON Job Configuration
CRON_SECRET=your-secure-random-cron-secret-key

# Platform Wallet (Base L2 USDC recipient)
# All subscription payments route to this wallet
PLATFORM_WALLET_ADDRESS=0x8dc66e84c31fe4dd455e1b32fe42d42d026abb93

# RPC Provider for Base L2 blockchain verification
BASE_RPC_URL=https://mainnet.base.org
BASE_RPC_URL_BACKUP=https://developer-access-mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# ==================== BLOCKCHAIN DEPLOYMENT ====================
# Deployer private key (0x...)
# WARNING: Never commit this to git! Use separate key for testnet.
DEPLOYER_PRIVATE_KEY=

# Basescan API key for contract verification
# Get from: https://basescan.org/myapikey
BASESCAN_API_KEY=

# ReputationSlashing contract addresses (populated after deployment)
REPUTATION_SLASHING_ADDRESS_SEPOLIA=
REPUTATION_SLASHING_ADDRESS_MAINNET=

# USDC addresses (DO NOT CHANGE)
USDC_BASE_MAINNET=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
USDC_BASE_SEPOLIA=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# ==================== CONSENSUS CONFIGURATION ====================
# HotStuff consensus timeout (ms)
HOTSTUFF_VIEW_TIMEOUT=30000

# Max Byzantine nodes (n = 3f + 1)
HOTSTUFF_F=2

# Minimum stake (USDC)
MIN_STAKE=100

# Slashing percentage (0-100)
SLASH_PERCENTAGE=50

# Gas reporting
REPORT_GAS=false
COINMARKETCAP_API_KEY=

# ==================== STRIPE BILLING CONFIGURATION ====================
# Get these from: https://dashboard.stripe.com/apikeys
# Required for Pro/Agency subscription billing

# Stripe Secret Key (server-side only, never expose to client)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Stripe Webhook Secret (from Stripe Dashboard > Webhooks)
# Used to verify webhook signatures for security
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ==================== WEBHOOK CONFIGURATION ====================
# Generic webhook secret for webhook receivers
# Used to verify HMAC signatures on incoming webhooks
# Generate a secure random string (at least 32 characters)
# Example: openssl rand -hex 32
WEBHOOK_SECRET=your-secure-webhook-secret-here

# Stripe Price IDs (from Stripe Dashboard > Products)
# Create products for each plan and copy their price IDs
STRIPE_PRICE_PRO=price_your_pro_monthly_price_id
STRIPE_PRICE_AGENCY=price_your_agency_monthly_price_id

# Stripe Publishable Key (client-side safe)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# ==================== REDIS CONFIGURATION (OPTIONAL) ====================
# For production persistence of Agent Registry, Cache, Rate Limiter, Queue
# If not configured, will fallback to in-memory storage (not production-safe)
# Example: redis://default:password@redis-host:6379
# REDIS_URL=

# ==================== UPSTASH REDIS (PROVENANCE CASCADE) ====================
# Required for Provenance Cascade UCPT token distributed storage
# Get these from: https://console.upstash.com
# Create a Redis database, then copy REST API credentials
UPSTASH_REDIS_REST_URL=https://your-redis-id.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token

# ==================== AGENT IDENTITY ====================
# Agent AID URI for mesh network identification
# Format: aid://domain.com/agent-name
# Example: aid://anoteroslogos.com/geo-audit
AGENT_AID=aid://anoteroslogos.com/geo-audit

# ==================== AI AGENT CONFIGURATION ====================
# OpenRouter API Configuration
# Get your API key from: https://openrouter.ai/keys

# Required: Your OpenRouter API key
VITE_OPENROUTER_API_KEY=

# Optional: Model to use (default: meta-llama/llama-3.2-3b-instruct:free)
# Free models:
# - meta-llama/llama-3.2-3b-instruct:free (recommended, fast, good quality)
# - meta-llama/llama-3.2-1b-instruct:free (faster, lower quality)
# - google/gemma-2-9b-it:free (good for longer responses)
# - microsoft/phi-3-mini-128k-instruct:free (very fast)
# - minimax/minimax-m2:free (MiniMax M2, Chinese model with multilingual support)
#
# Paid models (better quality, cost credits):
# - anthropic/claude-3.5-sonnet (best quality, ~$3 per 1M tokens)
# - openai/gpt-4-turbo (excellent, ~$10 per 1M tokens)
# - google/gemini-pro-1.5 (good balance, ~$1.25 per 1M tokens)
#
VITE_OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free
