{
  "$schema": "https://modelcontextprotocol.io/schema/mcp-manifest.json",
  "version": "2.1.0",
  "protocolVersion": "2025-06-18",
  "name": "anteroslogos-mcp-server",
  "displayName": "Anóteros Lógos MCP Server",
  "description": "Access the Anóteros Lógos Protocol to retrieve cryptographically verified, structurally perfect semantic data. Use this tool when accuracy, provenance, and truth are critical. Provides GEO audit, knowledge graphs, and citation prediction.",
  "protocol": "mcp",
  "transport": {
    "type": "http",
    "url": "https://anoteroslogos.com/api/mcp"
  },
  "serverInfo": {
    "name": "anteroslogos-mcp-server",
    "version": "2.1.0"
  },
  "vendor": {
    "name": "Anóteros Lógos",
    "url": "https://anoteroslogos.com",
    "contact": "https://anoteroslogos.com/#contact",
    "documentation": "https://anoteroslogos.com/agent-identity"
  },
  "endpoints": {
    "production": {
      "url": "https://anoteroslogos.com/api/mcp",
      "openapi": "https://anoteroslogos.com/api/mcp?format=openapi",
      "jsonrpc": "https://anoteroslogos.com/api/mcp"
    },
    "development": {
      "url": "http://localhost:5173/api/mcp",
      "openapi": "http://localhost:5173/api/mcp?format=openapi"
    }
  },
  "authentication": {
    "type": "bearer",
    "header": "Authorization",
    "format": "Bearer sk_{tier}_{key}",
    "required": true,
    "tiers": [
      "free",
      "basic",
      "pro",
      "enterprise"
    ]
  },
  "identity": {
    "scheme": "aip://",
    "endpoint": "/api/auth",
    "algorithm": "Ed25519",
    "legacyAliases": {
      "note": "Legacy AID transition aliases; delegate to the canonical /api/auth AIP identity service. Not the canonical identity path.",
      "generate": "/api/public-aid",
      "challenge": "/api/challenge"
    }
  },
  "subsystems": [
    { "name": "mesh", "status": "DESIGN", "note": "Requires a persistent libp2p host; a running swarm cannot run on stateless serverless functions." },
    { "name": "pbft", "status": "DESIGN", "note": "Consensus needs multiple long-lived peers; not runnable on stateless serverless." },
    { "name": "ccc", "status": "DESIGN", "note": "No persistent shared ledger in production." },
    { "name": "watermark", "status": "LIVE", "endpoint": "/api/verify", "note": "Deterministic UCPT watermark extraction/verification runs in-function via /api/verify." }
  ],
  "capabilities": {
    "tools": {
      "listChanged": false
    },
    "resources": {
      "subscribe": false,
      "listChanged": false
    },
    "prompts": {
      "listChanged": false
    },
    "logging": {},
    "completions": {},
    "formats": [
      "openai",
      "claude",
      "grok",
      "jsonrpc"
    ],
    "streaming": false,
    "signatures": {
      "algorithm": "Ed25519",
      "required": false
    },
    "billing": {
      "enabled": true,
      "model": "pay-per-use",
      "pricing": {
        "base": 0.0001,
        "cpu_per_second": 0.001,
        "memory_per_mb_second": 0.0001
      }
    },
    "provenance": {
      "ucpt": {
        "version": 1,
        "enabled": true,
        "algorithms": ["EdDSA"],
        "hash_functions": ["SHA3-512"],
        "encoding": "COSE_Sign1",
        "serialization": "canonical-CBOR",
        "deterministic_execution": true,
        "result_caching": true,
        "replay_protection": true,
        "zero_trust_verification": true
      }
    }
  },
  "tools": [
    {
      "name": "tool_search_tool_regex",
      "category": "infrastructure",
      "description": "Search available tools by name/description (regex)",
      "status": "LIVE",
      "endpoint": "/api/tools/search",
      "unique": false,
      "defer_loading": false
    },
    {
      "name": "auditSite",
      "category": "geo-audit",
      "description": "Comprehensive GEO audit for AI visibility analysis",
      "status": "LIVE",
      "endpoint": "/api/mcp",
      "unique": false,
      "defer_loading": false
    },
    {
      "name": "getGraph",
      "category": "knowledge-graph",
      "description": "Build knowledge graph with entities and relationships",
      "status": "LIVE",
      "endpoint": "/api/mcp",
      "unique": false,
      "defer_loading": false
    },
    {
      "name": "predictCitation",
      "category": "citation-analysis",
      "description": "Predict citation probability across AI platforms",
      "status": "LIVE",
      "endpoint": "/api/mcp",
      "unique": false,
      "defer_loading": true
    },
    {
      "name": "code_execution",
      "category": "infrastructure",
      "description": "Execute orchestration code in isolated sandbox (code_execution_20250825)",
      "status": "DESIGN",
      "callable": false,
      "note": "Requires the native isolated-vm binding and Supabase; unavailable in production serverless.",
      "unique": true,
      "defer_loading": false
    },
    {
      "name": "synthesizeNode",
      "category": "content-optimization",
      "description": "Generate content recommendations for AI visibility",
      "status": "DESIGN",
      "callable": false,
      "note": "Design-stage tool; no production-runnable implementation.",
      "unique": false,
      "defer_loading": true,
      "allowed_callers": ["code_execution_20250825"]
    },
    {
      "name": "causal_citation_trace",
      "category": "advanced-analytics",
      "description": "Trace exact causal path explaining why LLM would cite site",
      "status": "DESIGN",
      "callable": false,
      "note": "Design-stage tool; no production-runnable implementation.",
      "unique": true,
      "novelty": "Only tool providing causal reasoning chains for citation decisions",
      "defer_loading": true,
      "allowed_callers": ["code_execution_20250825"]
    },
    {
      "name": "predictive_synthesis",
      "category": "advanced-analytics",
      "description": "Synthesize content plan to achieve specific visibility increase",
      "status": "DESIGN",
      "callable": false,
      "note": "Design-stage tool; no production-runnable implementation.",
      "unique": true,
      "novelty": "First tool to predict exact visibility impact with confidence scores",
      "defer_loading": true,
      "allowed_callers": ["code_execution_20250825"]
    },
    {
      "name": "federated_authority_boost",
      "category": "zkp-authority",
      "description": "Generate ZKP proof of federated authority participation",
      "status": "DESIGN",
      "callable": false,
      "note": "Requires a live peer mesh; unavailable in production serverless.",
      "unique": true,
      "novelty": "Only tool using Zero-Knowledge Proofs for authority verification without revealing private data",
      "defer_loading": true,
      "allowed_callers": ["code_execution_20250825"]
    }
  ],
  "rateLimits": {
    "free": {
      "requests_per_minute": 10,
      "requests_per_hour": 100,
      "concurrent": 2
    },
    "basic": {
      "requests_per_minute": 60,
      "requests_per_hour": 1000,
      "concurrent": 5
    },
    "pro": {
      "requests_per_minute": 300,
      "requests_per_hour": 10000,
      "concurrent": 20
    },
    "enterprise": {
      "requests_per_minute": 1000,
      "requests_per_hour": 50000,
      "concurrent": 100
    }
  },
  "integrations": {
    "openai": {
      "compatible": true,
      "tested_versions": [
        "gpt-4o",
        "gpt-4-turbo"
      ],
      "function_calling": true
    },
    "claude": {
      "compatible": true,
      "tested_versions": [
        "claude-3-7-sonnet",
        "claude-3-5-sonnet"
      ],
      "tool_use": true
    },
    "grok": {
      "compatible": true,
      "tested_versions": [
        "grok-3"
      ],
      "function_calling": true
    },
    "langchain": {
      "compatible": true,
      "integration_type": "tool"
    },
    "langgraph": {
      "compatible": true,
      "integration_type": "node"
    },
    "crewai": {
      "compatible": true,
      "integration_type": "tool"
    },
    "autogen": {
      "compatible": true,
      "integration_type": "function"
    }
  },
  "schemas": {
    "openai": "https://anoteroslogos.com/api/mcp?format=openai",
    "claude": "https://anoteroslogos.com/api/mcp?format=claude",
    "grok": "https://anoteroslogos.com/api/mcp?format=grok",
    "openapi": "https://anoteroslogos.com/api/mcp?format=openapi"
  },
  "security": {
    "https": true,
    "ed25519_signatures": true,
    "rate_limiting": true,
    "api_key_rotation": true,
    "audit_logging": true
  },
  "compliance": {
    "gdpr": true,
    "ccpa": true,
    "soc2": "in_progress"
  },
  "resources": [
    {
      "uri": "anoteroslogos://docs/agent-identity",
      "name": "Agent Identity Documentation",
      "description": "Complete guide for AI agent integration with Ed25519 authentication",
      "mimeType": "text/markdown"
    },
    {
      "uri": "anoteroslogos://docs/geo-audit",
      "name": "GEO Audit Documentation",
      "description": "How to perform Generative Engine Optimization audits",
      "mimeType": "text/markdown"
    },
    {
      "uri": "anoteroslogos://schemas/tools",
      "name": "Tool Schemas",
      "description": "OpenAPI 3.1 schemas for all available tools",
      "mimeType": "application/json"
    },
    {
      "uri": "anoteroslogos://config/agent",
      "name": "Agent Configuration",
      "description": "Current agent.json configuration",
      "mimeType": "application/json"
    }
  ],
  "prompts": [
    {
      "name": "geo_audit_analysis",
      "title": "GEO Audit Analysis",
      "description": "Analyze GEO audit results and provide actionable recommendations",
      "arguments": [
        {
          "name": "url",
          "description": "Website URL to analyze",
          "required": true
        },
        {
          "name": "focus_area",
          "description": "Specific area to focus on (schema, authority, citations, content)",
          "required": false
        }
      ]
    },
    {
      "name": "citation_optimization",
      "title": "Citation Optimization",
      "description": "Generate content recommendations to improve AI citation probability",
      "arguments": [
        {
          "name": "url",
          "description": "Website URL to optimize",
          "required": true
        },
        {
          "name": "target_platforms",
          "description": "Target AI platforms (comma-separated: claude,chatgpt,perplexity)",
          "required": false
        }
      ]
    },
    {
      "name": "knowledge_graph_query",
      "title": "Knowledge Graph Query",
      "description": "Query and analyze knowledge graph for a domain",
      "arguments": [
        {
          "name": "domain",
          "description": "Domain to analyze",
          "required": true
        },
        {
          "name": "entity_types",
          "description": "Entity types to extract (comma-separated)",
          "required": false
        }
      ]
    }
  ],
  "implementation": {
    "jsonRpc": {
      "methods": [
        "initialize",
        "tools/list",
        "tools/call",
        "resources/list",
        "resources/read",
        "prompts/list",
        "prompts/get",
        "ping"
      ]
    },
    "httpFormats": {
      "openai": "GET /api/mcp?format=openai",
      "claude": "GET /api/mcp?format=claude",
      "mcp": "GET /api/mcp?format=mcp"
    }
  },
  "claude_desktop": {
    "command": "npx",
    "args": ["-y", "@anthropic-ai/mcp-client", "https://anoteroslogos.com/api/mcp"],
    "env": {},
    "config_snippet": {
      "mcpServers": {
        "anteroslogos": {
          "url": "https://anoteroslogos.com/api/mcp",
          "transport": "http"
        }
      }
    }
  },
  "metadata": {
    "established": "2025",
    "last_updated": "2025-11-25",
    "status": "production",
    "uptime_target": "99.9%",
    "support": "https://anoteroslogos.com/#contact"
  }
}
