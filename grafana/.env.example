# Grafana Configuration
# Copy this file to .env and update with your values

# Grafana Admin Credentials
GRAFANA_ADMIN_PASSWORD=change-this-secure-password
GRAFANA_SECRET_KEY=change-this-secret-key-to-random-string

# Prometheus Configuration
# Update the target URL in prometheus.yml to point to your API
# For production: https://anoteroslogos.com
# For staging: https://staging.anoteroslogos.com
# For local: http://localhost:3000

# Optional: Alertmanager Configuration
# ALERTMANAGER_URL=http://alertmanager:9093

# Optional: External URLs
# GF_SERVER_ROOT_URL=https://grafana.yourdomain.com
# GF_SERVER_DOMAIN=grafana.yourdomain.com
